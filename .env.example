# Frontend build-time variable.
# Set this in Netlify to the public URL of the deployed Render backend.
VITE_SERVER_URL=https://your-bluff-battle-backend.onrender.com

# Backend runtime variable.
# Set this in Render to the public URL of the deployed Netlify frontend.
# Multiple origins can be separated with commas.
CLIENT_ORIGIN=https://your-bluff-battle-site.netlify.app

# Render provides PORT automatically. This is only for local development.
PORT=3001
